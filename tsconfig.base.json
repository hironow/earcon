{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "composite": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "types": ["bun"],
    "paths": {
      "@earcon/core": ["./packages/core/src/index.ts"],
      "@earcon/engine-tone": ["./packages/engine-tone/src/index.ts"],
      "@earcon/react": ["./packages/react/src/index.ts"]
    }
  }
}
