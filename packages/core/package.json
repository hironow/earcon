{
  "name": "@earcon/core",
  "version": "0.0.1",
  "description": "Pure sonification state machine: monitors, hysteresis levels, ETA-based intensity, arbiter. No DOM, no Web Audio.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "publish:dry": "bun pm pack --dry-run"
  },
  "devDependencies": {
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hironow/earcon",
    "directory": "packages/core"
  },
  "keywords": [
    "sonification",
    "audio",
    "notification",
    "tone.js",
    "react",
    "earcon"
  ]
}
