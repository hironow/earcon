{
  "name": "@earcon/react",
  "version": "0.1.0",
  "description": "React bindings for earcon: NotifierProvider, useMonitor, useToneNotifier, headless UnlockGate.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsdown",
    "publish:dry": "bun pm pack --dry-run",
    "publish:npm": "bun publish"
  },
  "dependencies": {
    "@earcon/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "react": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  }
}
