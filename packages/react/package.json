{
  "name": "@earcon/react",
  "version": "0.0.2",
  "description": "React bindings for earcon: NotifierProvider, useMonitor, useToneNotifier, headless UnlockGate.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsdown",
    "publish:dry": "bun pm pack --dry-run"
  },
  "dependencies": {
    "@earcon/core": "workspace:*"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/hironow/earcon",
    "directory": "packages/react"
  },
  "keywords": [
    "sonification",
    "audio",
    "notification",
    "tone.js",
    "react",
    "earcon"
  ]
}
